# Local development (.env)
ENVIRONMENT=development

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Redis (local default; in cluster use redis.infra.svc.cluster.local via overlay)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Infisical (projeto Stuart, environment dev) — keys sincronizadas via ExternalSecret no cluster:
#   SUPABASE_URL
#   SUPABASE_KEY
# GHCR_USERNAME / GHCR_PASSWORD ficam no projeto Rolezin (infisical-cluster-secret-store)
# e alimentam o pull secret ghcr-api-pull compartilhado no namespace stuart.
# Crie o projeto em http://infisical.local:32080 e ajuste projectSlug em
# pk-devops-gitops/apps/external-secrets-infisical/base/infisical-stuart-cluster-secret-store.yaml
